[configuration]
entry_symbol = "ballistic_solver_gdextension_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "res://bin/ballistic_solver_gd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/ballistic_solver_gd.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libballistic_solver_gd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libballistic_solver_gd.linux.template_release.x86_64.so"
macos.debug = "res://bin/libballistic_solver_gd.macos.template_debug.framework"
macos.release = "res://bin/libballistic_solver_gd.macos.template_release.framework"

[dependencies]
windows.debug.x86_64 = {
  "res://bin/ballistic_solver.dll": ""
}
windows.release.x86_64 = {
  "res://bin/ballistic_solver.dll": ""
}
linux.debug.x86_64 = {
  "res://bin/libballistic_solver.so": ""
}
linux.release.x86_64 = {
  "res://bin/libballistic_solver.so": ""
}
macos.debug = {
  "res://bin/libballistic_solver.dylib": ""
}
macos.release = {
  "res://bin/libballistic_solver.dylib": ""
}
